{% set parent_route = content.parent_page %}
{% set parent_page = page.find(parent_route) %}

{% if parent_page %}
  {# get visible children #}
  {% set children = parent_page.children.visible %}

  {# filter featured only #}
  {% set children = children|filter(p => p.header.featured == true) %}

  {# apply limit if defined and > 0 #}
  {% if content.limit is defined and content.limit|int > 0 %}
    {% set children = children|slice(0, content.limit|int) %}
  {% endif %}



    {% for p in children %}
      {# <li><a href="{{ p.url }}">{{ p.menu|default(p.title) }}</a></li> #}
      {% include 'partials/cards/page_card.twig' %}

    {% endfor %}

{% else %}
  <p>Parent page "{{ parent_route }}" not found.</p>
{% endif %}