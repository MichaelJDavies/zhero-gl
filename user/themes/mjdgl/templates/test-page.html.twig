<!DOCTYPE html>
<html lang="en">
<!-- =====================================================================

  If you're wondering who built the site, I did! It's built on Grav CMS.

 ===================================================================== !-->
<head>

    {% block head %}
        <meta charset="utf-8" />
        <title>{% if header.title != "Home" %}{{ header.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>

        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% include 'partials/metadata.html.twig' %}

        <link rel="icon" href="{{ url('theme://images/favicon/favicon.svg') }}">
        <link rel="mask-icon" href="{{ url('theme://images/favicon/pinned-tab.svg') }}" color="#051432">
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/android-chrome-192x192.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/android-chrome-512x512.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/apple-touch-icon.png') }}" />
        <link rel="alternate icon" type="image/png" href="{{ url('theme://images/favicon/favicon-16x16.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/favicon-32x32.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/favicon.ico') }}" />

        <link rel="canonical" href="{{ page.url(true, true) }}" />
    {% endblock head%}


    <meta property="og:title" content="{% if header.title != "Home" %}{{ header.title|e('html') }} | {% endif %}{{ site.title|e('html') }}"/>
    <meta property="og:description" content="Sustainable supply chains made easy."/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content="{{ url('theme://images/og/Zhero-OG_min.webp') }}"/>

    {% block stylesheets %}
        {# {% do assets.addCss('https://unpkg.com/purecss@1.0.0/build/pure-min.css', 100) %} #}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" >

        {# {% do assets.addCss('https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css', 99) %} #}
        {# {% do assets.addCss('theme://css/custom.css', 98) %} #}
        {% do assets.addCss('theme://css/main.min.css', 97) %}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="{{ url('theme://css/custom.css') }}" >
        {# Fonts #}
        {# <link rel="preconnect" href="https://fonts.gstatic.com">
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=PT+Mono&display=swap"> #}
        {# <link rel="preconnect" href="https://fonts.gstatic.com">
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet"> #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">


        {# <link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Inter&display=swap" rel="stylesheet">

<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
 #}

        {# AOS #}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://unpkg.com/aos@2.3.1/dist/aos.css" >

    {% endblock %}

    {% block assets deferred %}
        {{ assets.css()|raw }}
        {{ assets.js()|raw }}
    {% endblock %}


    <!-- Global site tag (gtag.js) - Google Analytics -->
    {# <script async src="https://www.googletagmanager.com/gtag/js?id=G-PL0ZK20J6X"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PL0ZK20J6X');
    </script> #}


    <style>

        body{
            overflow-x: hidden;
        }
        .cont{
            display: flex; 
            flex-wrap: wrap; 
            margin: 0 auto; 
            width: 95%; 
            max-width: 1700px;
            {# display: none; #}
        }

        .logobox{
            width: 200px; 
            height: 70px; 
            background-color: green; 
            position: sticky; top:0;
            flex-grow: 0;
            flex-shrink: 0;

        }
        .tnav{
            width: calc(100% - 200px); 
            height: 70px; 
            background-color: lightgrey; 
            text-align: right;
            flex-grow: 0;
            flex-shrink: 0;
            {# flex-basis: 100%; #}

        }

        .snav{
            {# width: 300px; #}
            height: 500px; 
            background-color: lightgrey; 
            position: sticky; top: 70px;
            flex-grow: 2;
            flex-shrink: 2;

            
        }
        .cont-inner{
            {# width: 100%; #}
            max-width: 1340px;
            margin: 0 auto; 
            height: 1200px; 
            background-color: lightgreen; 
            flex-grow: 10;
            flex-shrink: 10;
            {# flex-basis: 100%; #}
            {# display: none; #}
        }

        .full-width{
            margin-inline: calc(50% - 50vw);
            height: 200px;
            background-color: green;
        }

    </style>
</head>




