<!DOCTYPE html>
<html lang="en">
<!-- =====================================================================

  If you're wondering who built the site, I did! It's built on Grav CMS.

 ===================================================================== !-->
<head>

    {% block head %}
        <meta charset="utf-8" />
        <title>{% if header.title != "Home" %}{{ header.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>

        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% include 'partials/metadata.html.twig' %}

        <link rel="icon" href="{{ url('theme://images/favicon/favicon.svg') }}">
        <link rel="mask-icon" href="{{ url('theme://images/favicon/pinned-tab.svg') }}" color="#051432">
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/android-chrome-192x192.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/android-chrome-512x512.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/apple-touch-icon.png') }}" />
        <link rel="alternate icon" type="image/png" href="{{ url('theme://images/favicon/favicon-16x16.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/favicon-32x32.png') }}" />
        <link rel="alternate icon"  type="image/png" href="{{ url('theme://images/favicon/favicon.ico') }}" />

        <link rel="canonical" href="{{ page.url(true, true) }}" />
    {% endblock head%}


    <meta property="og:title" content="{% if header.title != "Home" %}{{ header.title|e('html') }} | {% endif %}{{ site.title|e('html') }}"/>
    <meta property="og:description" content="Sustainable supply chains made easy."/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content="{{ url('theme://images/og/Zhero-OG_min.webp') }}"/>

    {% block stylesheets %}
        {# {% do assets.addCss('https://unpkg.com/purecss@1.0.0/build/pure-min.css', 100) %} #}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" >

        {# {% do assets.addCss('https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css', 99) %} #}
        {# {% do assets.addCss('theme://css/custom.css', 98) %} #}
        {% do assets.addCss('theme://css/main.min.css', 97) %}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="{{ url('theme://css/custom.css') }}" >
        {# Fonts #}
        {# <link rel="preconnect" href="https://fonts.gstatic.com">
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=PT+Mono&display=swap"> #}
        <link rel="preconnect" href="https://fonts.gstatic.com">
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500&display=swap" rel="stylesheet">

        {# <link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Inter&display=swap" rel="stylesheet">

<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
 #}

        {# AOS #}
        <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://unpkg.com/aos@2.3.1/dist/aos.css" >

    {% endblock %}

    {% block assets deferred %}
        {{ assets.css()|raw }}
        {{ assets.js()|raw }}
    {% endblock %}


    <!-- Global site tag (gtag.js) - Google Analytics -->
    {# <script async src="https://www.googletagmanager.com/gtag/js?id=G-PL0ZK20J6X"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PL0ZK20J6X');
    </script> #}
</head>


{# Body #}

<body class="{{ page.header.body_classes }}">







<div class="home-container">


        <nav>

            <div class="inner">

                <a class="logo-mobile" href="/">{% include 'svgs/Zhero-Primary.svg' %}</a>
               <div class="links-container">

                    <div class="links" id="links">
                        {% set coll = page.collection({
                          items: '@root.pages',
                          order: { by: 'default', dir: 'asc' }
                        }) %}


                        {% for p in coll if p.route != '/' %}
                            {% set is_active = p.active or p.activeChild %}
                          <a class="{{ is_active ? 'active' : '' }}" href="{{ p.url|e }}">{{ p.menu|default(p.title)|e }}</a>
                        {% endfor %}
                        <a href="/search">{% include 'svgs/Search.svg' %}</a>
                    </div>
                </div>
                <div class="mobile-container">
                    <a class="message" id="mobile" onclick="navmob(this)" href="#">
                        {% include 'svgs/hamburger.html.twig' %}
                    </a>
                </div>     
                
            </div>
       
        </nav>



                <div class="home-hero">
                    {# <img class="imgleft" src="{{ url('theme://images/home/imgleft_min.webp') }}" alt=""> #}
                    <div class="imgleft"></div>
                    <div class="inner">
                        <div class="overline">Our brand</div>
                    <h1>How to be <span class="hero-underline">Zhero</span></h1>
                    </div>
                    <div class="imgright"></div>
                    {# <img class="imgright" src="" alt=""> #}
                </div>
                <div class="home-standfirst">
                    <div class="inner">
                        <div class="content">
                            <h3>Welcome to our brand guide</h3>
                    <p>This is where you’ll find everything you need to keep our brand looking sharp and sounding like us... real, down-to-earth, and full of purpose. Whether you're writing, designing, or dreaming something up, this guide is here to help you carry the Zhero spirit into everything you do.</p>
                        </div>
                        
                    </div>
                </div>


            <div class="home">  
                <div class="section-head">
                    <a href="/writing" class="heading">
                        <h2>Writing</h2>
                        <div>
                            {% include 'svgs/rightarrow.svg' %} 
                        </div>
                    </a>
                    <div class="section-description">
                        <p>Everyday we’re writing a new chapter of the Zhero story. Our writing guides capture the core principles of who we are and how we communicate.</p>   
                    </div>
                </div>


                {% set parent_page = page.find('/writing') %}

                {% set children = parent_page.children.visible %}

                <div class="blocks-cardlist">
                {% for p in children %}
                  {% include 'partials/page-card.twig' %}
                {% endfor %} 
                </div>

                <div class="section-head">
                    <a href="/design" class="heading">
                        <h2>Design</h2>
                        <div>
                            {% include 'svgs/rightarrow.svg' %} 
                        </div>
                    </a>
                    <div class="section-description">
                        <p>Our visual identity is how we communicate our brand essence in a visual way. Here you’ll find guides for how to </p>   
                    </div>
                </div>


                {% set parent_page = page.find('/design') %}

                {% set children = parent_page.children.visible %}

                <div class="blocks-cardlist">
                {% for p in children %}
                  {% include 'partials/page-card.twig' %}
                {% endfor %} 
                </div>

                <div class="section-head">
                    <a href="/design" class="heading">
                        <h2>Resources</h2>
                        <div>
                            {% include 'svgs/rightarrow.svg' %} 
                        </div>
                    </a>
                    <div class="section-description">
                        <p>Download everything you need to start working with the Zhero brand. From our logo suite to our brushworks, everything you need can be found here.</p>   
                    </div>
                </div>


                {% set parent_page = page.find('/resources') %}

                {% set children = parent_page.children.visible %}

                <div class="blocks-cardlist">
                {% for p in children %}
                  {% include 'partials/page-card.twig' %}
                {% endfor %} 
                </div>
            
            </div>

            <section id="footer">
                <hr />
                <div class="footer-content">
                    <div>© Zhero 2025</div>
                    <div>Design: <a href="https://mjd.studio">MJD Studio</a></div>
                </div>

            </section>


</div>

           



        


    {# Mobile Navigation #}
    <section id="mobNav">
        <div class="moblinks">
            {% set coll = page.collection({
                      items: '@root.pages',
                      order: { by: 'default', dir: 'asc' }
                    }) %}


                    {% for p in coll %}
                        {% set is_active = p.active or p.activeChild %}
                      <a onclick="navmobClose(this)" class="{{ is_active ? 'active' : '' }}" href="{{ p.url|e }}">{{ p.menu|default(p.title)|e }}</a>
                    {% endfor %}
           {#  <a onclick="navmobClose(this)" href="/">Home</a>
            <a onclick="navmobClose(this)" href="/projects">Work</a>
            <a onclick="navmobClose(this)" href="/play">Play</a>
            <a onclick="navmobClose(this)" href="/about">About</a> #}
        </div>
    </section>
    
    <div id="overlay">
        
    </div>








{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}



